# ==============================================================================
# DRA. LAURA FERREIRA | APACHE CONFIGURATION (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Sitemap XML
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # URLs Amigáveis para Artigos
    RewriteRule ^artigos/plano-negou-cirurgia/?$ artigos/plano-negou-cirurgia.php [L]
    RewriteRule ^artigos/medicamentos-alto-custo/?$ artigos/medicamentos-alto-custo.php [L]
    RewriteRule ^artigos/reajuste-faixa-etaria/?$ artigos/reajuste-faixa-etaria.php [L]

    # URLs Institucionais
    RewriteRule ^politica-de-cookies/?$ politica-de-cookies.php [L]
    RewriteRule ^politica-de-privacidade/?$ politica-de-cookies.php [L]

    # Forçar HTTPS em produção caso habilitado
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Não reescrever arquivos e diretórios existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# Compressão GZIP para Alta Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache de Navegador para Imagens e Recursos Estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Proteção de Diretórios Sensíveis
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
